pragma solidity ^0.8.24;

import {Test} from "forge-std/Test.sol";
import {ArcStreamVault} from "../ArcStreamVault.sol";
import {MockERC20} from "../test-helpers/MockERC20.sol";

/// @dev Cross-checks proofs generated by the browser library (src/lib/pq.ts, built with viem)
/// against the contract. Vectors use master 0x11.., nonce 0x22.., chainid 31337, fixed vault and employer.
contract ArcStreamVaultTsVectorTest is Test {
    address constant VAULT = address(uint160(0xa11ce));
    address constant EMPLOYER = address(uint160(0xe11));
    address constant CONTRACTOR = address(0xC0);
    bytes32 constant ROOT = 0x8db3d141aa7b57055c5191e79e4a4fa44d1484abb0b5b9cde8144419b288fcbc;

    bytes constant P0 =
        hex"";
    bytes constant P3 =
        hex"";

    MockERC20 usdc;
    ArcStreamVault vault;

    function setUp() public {
        vm.chainId(31337);
        usdc = new MockERC20("USDC", "USDC", 6);
        deployCodeTo("ArcStreamVault.sol:ArcStreamVault", abi.encode(address(usdc)), VAULT);
        vault = ArcStreamVault(VAULT);
        usdc.mint(EMPLOYER, 1_000e6);
        vm.prank(EMPLOYER);
        usdc.approve(VAULT, type(uint256).max);

        uint256[] memory amounts = new uint256[](3);
        string[] memory descriptions = new string[](3);
        for (uint256 i; i < 3; ++i) {
            amounts[i] = 100e6;
            descriptions[i] = "task";
        }
        vm.prank(EMPLOYER);
        vault.createEscrow(CONTRACTOR, amounts, descriptions, ROOT);
    }

    function test_BrowserProofReleasesMilestoneZero() public {
        vm.prank(CONTRACTOR);
        vault.submitMilestoneWork(1, 0, "proof");
        vm.prank(EMPLOYER);
        vault.approveMilestone(1, 0);

        vm.expectEmit(true, false, false, true, VAULT);
        emit ArcStreamVault.QuantumProofVerified(1, 0, ROOT);
        vm.prank(EMPLOYER);
        vault.releaseMilestone(1, 0, P0);
        assertEq(usdc.balanceOf(CONTRACTOR), 100e6);
    }

    function test_BrowserProofRefundsWithActionEqualMilestoneCount() public {
        vm.expectEmit(true, false, false, true, VAULT);
        emit ArcStreamVault.QuantumProofVerified(1, 3, ROOT);
        vm.prank(EMPLOYER);
        vault.refundRemaining(1, P3);
        assertEq(usdc.balanceOf(EMPLOYER), 1_000e6);
    }

    function test_WrongActionProofRejected() public {
        vm.prank(CONTRACTOR);
        vault.submitMilestoneWork(1, 1, "proof");
        vm.prank(EMPLOYER);
        vault.approveMilestone(1, 1);
        vm.expectRevert(ArcStreamVault.InvalidQuantumProof.selector);
        vm.prank(EMPLOYER);
        vault.releaseMilestone(1, 1, P0);
    }
}
